{
  "openapi": "3.0.1",
  "info": {
    "title": "我的博客 API（ThinkPHP 8.1）",
    "version": "2.1.0",
    "description": "ThinkPHP 8.1 + MySQL 实现的博客接口，共 21 个。\n\n## 统一返回\n\ncode=0 成功，其余失败：\n1 参数错误 / 401 未登录 / 403 无权限 / 404 不存在 /\n1001 密码错误 / 1002 用户名已存在 / 1004 已点赞 / 1005 只能删自己的。\n\n## 鉴权\n\nSession Cookie：先调 login 或 register，Apifox 会自动保存 PHPSESSID。\n\n## 测试顺序\n\n1. POST /api/register\n2. GET  /api/me\n3. POST /api/article\n4. 管理员登录 → POST /api/admin/article/audit\n5. GET  /api/articles\n6. POST /api/like（再点一次返回 1004）\n7. POST /api/comment\n8. GET  /api/article?id=x\n\n## 注意\n\nPOST 接口不能直接在浏览器地址栏打开。"
  },
  "servers": [
    {
      "url": "http://43.143.237.166/api",
      "description": "线上环境"
    },
    {
      "url": "http://127.0.0.1/mymessage/tp8/public/index.php/api",
      "description": "本地环境"
    }
  ],
  "tags": [
    {
      "name": "认证",
      "description": "注册 / 登录 / 退出 / 当前用户"
    },
    {
      "name": "文章",
      "description": "列表 / 详情 / 发布 / 删除"
    },
    {
      "name": "评论",
      "description": "列表 / 发表 / 删除"
    },
    {
      "name": "点赞",
      "description": "点赞 / 取消点赞"
    },
    {
      "name": "我的",
      "description": "我的文章 / 我的评论 / 我的点赞"
    },
    {
      "name": "管理端",
      "description": "审核 / 后台列表 / 用户"
    }
  ],
  "paths": {
    "/api/register": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "注册",
        "description": "公开。用户名 3-20 字，密码≥6 位，两次密码必须一致。成功后自动登录。",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "description": "用户名 3-20 字"
                  },
                  "password": {
                    "type": "string",
                    "description": "密码 ≥6 位"
                  },
                  "password2": {
                    "type": "string",
                    "description": "确认密码"
                  }
                },
                "required": [
                  "username",
                  "password",
                  "password2"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "msg": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "type": "object",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "1002": {
            "description": "用户名已存在",
            "content": {
              "application/json": {
                "example": {
                  "code": 1002,
                  "msg": "用户名已存在",
                  "data": null
                }
              }
            }
          },
          "400": {
            "description": "参数校验失败",
            "content": {
              "application/json": {
                "example": {
                  "code": 1,
                  "msg": "参数校验失败",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
