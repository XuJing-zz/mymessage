{
  "openapi": "3.0.1",
  "info": {
    "title": "我的博客 API",
    "version": "1.0.0",
    "description": "博客系统接口文档（PHP + MySQL）。\n\n统一返回：{ code, msg, data }，code=0 成功。\n\n错误码：0 成功 / 1 参数错误 / 401 未登录 / 403 无权限 / 404 不存在 / 1001 密码错误 / 1002 用户名已存在 / 1004 已点赞 / 1005 只能删自己的内容。\n\n鉴权：Session Cookie，先调登录接口，Apifox 会自动保存 PHPSESSID。\n\n文章状态：0 待审核 / 1 已通过 / 2 已驳回，前台只展示 1。"
  },
  "servers": [
    {
      "url": "http://localhost/mymessage/backend",
      "description": "本地开发"
    }
  ],
  "tags": [
    {
      "name": "认证",
      "description": "注册 / 登录 / 退出 / 当前用户"
    },
    {
      "name": "文章",
      "description": "列表、详情、发布、删除"
    },
    {
      "name": "评论",
      "description": "列表、发表、删除"
    },
    {
      "name": "点赞",
      "description": "点赞 / 取消"
    },
    {
      "name": "我的",
      "description": "我的文章 / 评论 / 点赞"
    },
    {
      "name": "管理端",
      "description": "审核、后台列表、用户"
    }
  ],
  "paths": {
    "/api/register.php": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "注册",
        "description": "公开。用户名 3-20 字，密码至少 6 位。role 固定 0（普通用户），不接受前端传入。注册成功后自动登录。1002 = 用户名已存在。",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "description": "用户名，3-20 字符"
                  },
                  "password": {
                    "type": "string",
                    "description": "密码，至少 6 位"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 0
                    },
                    "msg": {
                      "type": "string",
                      "example": "ok"
                    },
                    "data": {
                      "type": "object",
                      "nullable": true
                    }
                  }
                },
                "example": {
                  "code": 0,
                  "msg": "ok",
                  "data": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/login.php": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "登录",
        "description": "公开。校验密码后写入 session 并返回真实 role，前端据此决定跳 / 还是 /admin/articles。1001 = 用户名或密码错误。",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
